# ──────────────────────────────────────────────────────────────────
# PageTurn — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to git.
# ──────────────────────────────────────────────────────────────────

# Supabase (required)
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Books API key (optional but recommended for higher rate limits)
# Get one at: https://console.cloud.google.com → APIs → Google Books API
# Without a key: ~1,000 requests/day limit
# With a key: 1,000,000 requests/day
VITE_GOOGLE_BOOKS_API_KEY=
